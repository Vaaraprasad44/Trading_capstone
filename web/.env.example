DATABASE_URL="postgresql://postgres:postgres@localhost:5433/meridian"

# SnapTrade personal-flow credentials (read-only; see docs/SPIKE-SNAPTRADE.md).
# Personal (PERS-) keys need no userSecret. Get them at dashboard.snaptrade.com.
SNAPTRADE_CLIENT_ID=""
SNAPTRADE_CONSUMER_KEY=""

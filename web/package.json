{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.mts",
    "worker": "tsx --env-file=.env scripts/worker.mts",
    "test:trust": "tsx --env-file=.env scripts/test-feed-map.mts && tsx --env-file=.env scripts/test-trust-engine.mts",
    "mcp:portfolio": "tsx --env-file=.env scripts/portfolio-mcp.mts",
    "typecheck": "tsc --noEmit",
    "predev": "docker compose -f ../docker-compose.yml up -d --wait"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.19.3",
    "@react-three/fiber": "^9.6.1",
    "ag-grid-community": "^36.0.2",
    "ag-grid-react": "^36.0.2",
    "chart.js": "^4.5.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
